{
  "employeeNumber": "EMP-TEST-001",
  "firstName": "Anna",
  "lastName": "Meier-Schultz",
  "email": "anna.meier@swiftapp.ch",
  "phone": "+41 79 123 45 67",
  "hireDate": "2026-04-01",
  "departmentId": "{{department_id}}",
  "position": "Senior Watchmaker",
  "salary": "95000.0000",
  "active": true
}

> {%
    client.test("Update employee", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

