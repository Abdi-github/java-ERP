### ============================================================
### SwiftApp ERP — CRM API (Contacts + Interactions)
### IntelliJ HTTP Client
### Prerequisites: Run 01-auth.http "Login" first
### ============================================================

### ============================================================
### Contacts API
### ============================================================

### ----------------------------------------------------------
### 1. List contacts
### ----------------------------------------------------------
GET {{base-url}}/api/v1/contacts?page=0&size=10
Authorization: Bearer {{auth_token}}

> {%
    client.test("List contacts", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 2. Search contacts
### ----------------------------------------------------------
GET {{base-url}}/api/v1/contacts?search=Jean&page=0&size=10
Authorization: Bearer {{auth_token}}

> {%
    client.test("Search contacts", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 3. Get contact by ID
### ----------------------------------------------------------
GET {{base-url}}/api/v1/contacts/{{contact_id}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("Get contact", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 4. Create contact
### ----------------------------------------------------------
POST {{base-url}}/api/v1/contacts
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "firstName": "Jean-Pierre",
  "lastName": "Dubois",
  "email": "jp.dubois@example.ch",
  "phone": "+41 22 345 67 89",
  "company": "Luxury Watches SA",
  "position": "Procurement Manager",
  "customerId": null,
  "notes": "Met at Basel World 2026",
  "active": true
}

> {%
    client.test("Create contact", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
    if (response.body.id) {
        client.global.set("test_contact_id", response.body.id);
    }
%}

### ----------------------------------------------------------
### 5. Create contact linked to customer
### ----------------------------------------------------------
POST {{base-url}}/api/v1/contacts
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "firstName": "Maria",
  "lastName": "Rossi",
  "email": "maria.rossi@example.ch",
  "phone": "+41 91 234 56 78",
  "company": "Rossi Jewellers",
  "position": "Owner",
  "customerId": "{{customer_id}}",
  "notes": "Retail partner in Ticino",
  "active": true
}

> {%
    client.test("Create linked contact", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
%}

### ----------------------------------------------------------
### 6. Create contact — validation error (400)
### ----------------------------------------------------------
POST {{base-url}}/api/v1/contacts
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "firstName": "",
  "lastName": "",
  "email": "invalid"
}

> {%
    client.test("Contact validation fails", function() {
        client.assert(response.status === 400, "Expected 400");
    });
%}

### ----------------------------------------------------------
### 7. Update contact
### ----------------------------------------------------------
PUT {{base-url}}/api/v1/contacts/{{test_contact_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "firstName": "Jean-Pierre",
  "lastName": "Dubois-Martin",
  "email": "jp.dubois@example.ch",
  "phone": "+41 22 345 67 89",
  "company": "Luxury Watches SA",
  "position": "Head of Procurement",
  "notes": "Updated after Baselworld",
  "active": true
}

> {%
    client.test("Update contact", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 8. Delete contact
### ----------------------------------------------------------
DELETE {{base-url}}/api/v1/contacts/{{test_contact_id}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("Delete contact", function() {
        client.assert(response.status === 200 || response.status === 204, "Expected 200/204");
    });
%}

### ============================================================
### Interactions API (nested under contacts)
### ============================================================

### ----------------------------------------------------------
### 9. List interactions for a contact
### ----------------------------------------------------------
GET {{base-url}}/api/v1/contacts/{{contact_id}}/interactions?page=0&size=10
Authorization: Bearer {{auth_token}}

> {%
    client.test("List interactions", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 10. Create CALL interaction
### ----------------------------------------------------------
POST {{base-url}}/api/v1/contacts/{{contact_id}}/interactions
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "contactId": "{{contact_id}}",
  "interactionType": "CALL",
  "subject": "Initial inquiry about Alpine collection",
  "description": "Jean-Pierre called to inquire about our Alpine range. Very interested in the Chronograph model.",
  "interactionDate": "2026-03-31T10:30:00Z",
  "followUpDate": "2026-04-07"
}

> {%
    client.test("Create call interaction", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
%}

### ----------------------------------------------------------
### 11. Create EMAIL interaction
### ----------------------------------------------------------
POST {{base-url}}/api/v1/contacts/{{contact_id}}/interactions
