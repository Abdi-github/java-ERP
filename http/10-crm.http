Content-Type: application/json

{
  "contactId": "{{contact_id}}",
  "interactionType": "EMAIL",
  "subject": "Product catalog sent",
  "description": "Sent PDF catalog for the 2026 Alpine collection.",
  "interactionDate": "2026-03-31T14:00:00Z"
}

> {%
    client.test("Create email interaction", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
%}

