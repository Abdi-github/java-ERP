### ============================================================
### SwiftApp ERP — Master Data: Materials, Categories, UoM
### IntelliJ HTTP Client
### Prerequisites: Run 01-auth.http "Login" first
### ============================================================

### ============================================================
### Materials API
### ============================================================

### ----------------------------------------------------------
### 1. List materials
### ----------------------------------------------------------
GET {{base-url}}/api/v1/materials?page=0&size=10
Authorization: Bearer {{auth_token}}

> {%
    client.test("List materials", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 2. Search materials
### ----------------------------------------------------------
GET {{base-url}}/api/v1/materials?search=gold&page=0&size=10
Authorization: Bearer {{auth_token}}

> {%
    client.test("Search materials", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 3. Get material by ID
### ----------------------------------------------------------
GET {{base-url}}/api/v1/materials/{{material_id}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("Get material", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 4. Create material
### ----------------------------------------------------------
POST {{base-url}}/api/v1/materials
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "sku": "MAT-GOLD-18K",
  "name": "18K Gold Sheet",
  "description": "Premium 18-karat gold for watch cases",
  "categoryId": "{{category_id}}",
  "unitOfMeasureId": "{{uom_id}}",
  "unitPrice": "850.0000",
  "vatRate": "STANDARD_8_1",
  "minimumStock": "10.0000",
  "nameTranslations": {
    "de": "18K Goldblech",
    "fr": "Feuille d'or 18K",
    "it": "Foglio d'oro 18K",
    "en": "18K Gold Sheet"
  },
  "descriptionTranslations": {
    "de": "Premium 18-Karat Gold für Uhrengehäuse",
    "fr": "Or 18 carats premium pour boîtiers de montres",
    "it": "Oro 18 carati premium per casse di orologi",
    "en": "Premium 18-karat gold for watch cases"
  }
}

> {%
    client.test("Create material", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
    if (response.body.id) {
        client.global.set("test_material_id", response.body.id);
    }
%}

### ----------------------------------------------------------
### 5. Update material
### ----------------------------------------------------------
PUT {{base-url}}/api/v1/materials/{{test_material_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "sku": "MAT-GOLD-18K",
  "name": "18K Gold Sheet — Updated",
  "description": "Updated description",
  "unitPrice": "900.0000",
  "vatRate": "STANDARD_8_1",
  "minimumStock": "15.0000"
}

> {%
    client.test("Update material", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 6. Delete material
### ----------------------------------------------------------
DELETE {{base-url}}/api/v1/materials/{{test_material_id}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("Delete material", function() {
        client.assert(response.status === 200 || response.status === 204, "Expected 200/204");
    });
%}

