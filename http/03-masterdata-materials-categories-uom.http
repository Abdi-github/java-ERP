### ----------------------------------------------------------
### 11. Create category (root)
### ----------------------------------------------------------
POST {{base-url}}/api/v1/categories
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Test Category",
  "description": "A test category for API testing",
  "parentId": null,
  "nameTranslations": {
    "de": "Testkategorie",
    "fr": "Catégorie de test",
    "it": "Categoria di test",
    "en": "Test Category"
  },
  "descriptionTranslations": {
    "de": "Eine Testkategorie",
    "fr": "Une catégorie de test",
    "it": "Una categoria di test",
    "en": "A test category"
  }
}

> {%
    client.test("Create category", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
    if (response.body.id) {
        client.global.set("test_category_id", response.body.id);
    }
%}

### ----------------------------------------------------------
### 12. Create sub-category
### ----------------------------------------------------------
POST {{base-url}}/api/v1/categories
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Test Sub-Category",
  "description": "A child category",
  "parentId": "{{test_category_id}}",
  "nameTranslations": {
    "de": "Test-Unterkategorie",
    "en": "Test Sub-Category"
  }
}

> {%
    client.test("Create sub-category", function() {
        client.assert(response.status === 200 || response.status === 201, "Expected 200/201");
    });
%}

### ----------------------------------------------------------
