DELETE {{base-url}}/api/v1/categories/{{test_category_id}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("Delete category", function() {
        client.assert(response.status === 200 || response.status === 204, "Expected 200/204");
    });
