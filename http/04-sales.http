### ----------------------------------------------------------
### 16. Cancel order (create new one first)
### ----------------------------------------------------------
POST {{base-url}}/api/v1/sales-orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "customerId": "{{customer_id}}",
  "orderDate": "2026-03-31",
  "notes": "Order to be cancelled",
  "lines": [
    {
      "productId": "{{product_id}}",
      "description": "Test Product",
      "quantity": "1.0000",
      "unitPrice": "1000.0000",
      "discountPct": "0.00",
      "vatRate": "STANDARD_8_1",
      "position": 1
    }
  ]
}

> {%
    if (response.body.id) {
        client.global.set("cancel_order_id", response.body.id);
    }
%}

### ----------------------------------------------------------
### 17. Cancel the order
### ----------------------------------------------------------
POST {{base-url}}/api/v1/sales-orders/{{cancel_order_id}}/cancel
Authorization: Bearer {{auth_token}}

> {%
    client.test("Cancel order", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### ----------------------------------------------------------
### 18. Delete sales order (DRAFT only)
### ----------------------------------------------------------
DELETE {{base-url}}/api/v1/sales-orders/{{cancel_order_id}}
Authorization: Bearer {{auth_token}}

> {%
    client.test("Delete order", function() {
        client.assert(response.status === 200 || response.status === 204 || response.status === 400, "Expected success or cannot delete non-draft");
    });
%}

