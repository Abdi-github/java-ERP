# ──────────────────────────────────────────────────────────
# SwiftApp ERP — Environment Variables Example
# ──────────────────────────────────────────────────────────
# Copy this file to .env (dev) or .env.prod (production)
# and fill in the actual values.
# ──────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=swiftapp_erp
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=<your-database-password>

# ── pgAdmin (dev only) ───────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@swiftapp.ch
PGADMIN_DEFAULT_PASSWORD=<your-pgadmin-password>

# ── Mail ──────────────────────────────────────────────────
MAIL_HOST=<smtp-host>
MAIL_PORT=<smtp-port>
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=noreply@swiftapp.ch

# ── Application ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080
JWT_SECRET=<your-jwt-secret-256-bit-minimum>
JWT_EXPIRATION_MS=86400000

